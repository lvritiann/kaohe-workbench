# 考核方案与内部公文不上传公网仓库
*.docx
*.xlsx
*.xls
*.pdf
~$*

# 本机工具：Python 脚本入库留档，其余本地文件不入库
tools/*
!tools/*.py
!tools/_t_*.js
# QA 临时验收脚本（可随时重跑重生成，不入库）
tools/_qa_*
# Cloudflare Worker 中转源码：不含任何密钥（密钥在 Worker 环境变量里），需要入库留档
!tools/worker/
# 本机中转（纯 Node）：源码不含密钥，入库留档；config.json 与日志必须排除
!tools/relay/
!tools/relay/**
tools/relay/config.json
tools/relay/relay.log
tools/relay/node_modules/
# tools/airscript/ 里的 .js 已入库留档；.py 也一并入库（均不含令牌）
# ★ 令牌只存在于金山脚本编辑器与腾讯云环境变量，源码里一律留空
!tools/airscript/
!tools/airscript/*.py
tools/airscript/__pycache__/
inbox/
.workbuddy/

# 系统残留
.DS_Store
Thumbs.db

# GitHub 访问令牌（严禁入库）
.gh_token*

# 临时校验文件
_tmp_*

# 内部文档：交接/部署/令牌说明，含敏感路径与凭据线索，仅本地保存
# ★ docs/ 是 GitHub Pages 发布根目录，任何放进 docs/ 的文件都会被公网访问
#   2026-11-25 事故：docs/项目交接文档.md 曾含账号级令牌明文并随公开仓库外泄
内部文档/

# 含明文令牌的零配置客户端（严禁入库 / 严禁公开分发）
*_已配置.html
分发包_*.zip

# 浏览器调试产物（仅仓库根目录，不影响 docs/assets 里的图片）
.playwright-cli/
/*.png
